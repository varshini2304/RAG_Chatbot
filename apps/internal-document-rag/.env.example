# ============================================================
# Internal Document RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values below.
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env  (Windows PowerShell)

# ------------------------------------------------------------
# LLM Provider Selection
# Set to "gemini" to use Google Gemini, or "groq" to use Groq.
# ------------------------------------------------------------
LLM_PROVIDER=groq

# ------------------------------------------------------------
# Google Gemini API (required when LLM_PROVIDER=gemini)
# Obtain your key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------
# Groq API (required when LLM_PROVIDER=groq)
# Obtain your key at: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# ------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------
APP_ENV=development
USER_CREDENTIALS=admin:admin123,user:user123

# ------------------------------------------------------------
# Storage Paths
# Override these in container/cloud deployments when attaching
# persistent volumes. DATA_DIR is the base for uploads, chats,
# and Chroma unless the subpaths are overridden directly.
# ------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHAT_HISTORY_DIR=./data/chats
CHROMA_DB_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=internal_document_chunks_multilingual_v1

# ------------------------------------------------------------
# Upload Limits
# Maximum file size in megabytes (default: 10)
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------
# Chunking Configuration
# CHUNK_SIZE: characters per text chunk (default: 800)
# CHUNK_OVERLAP: overlap between consecutive chunks (default: 120)
# ------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ------------------------------------------------------------
# Embedding Configuration
# EMBEDDING_MODEL_NAME: multilingual semantic search model used for
# chunk indexing and question embedding.
# EMBEDDING_BATCH_SIZE: batch size for model inference (default: 32)
# EMBEDDING_DIMENSION: output vector dimension (default: 1024)
# EMBEDDING_OFFLINE_MODE: set True to load locally cached weights without network checks (default: True)
# HF_HUB_OFFLINE: set 1 to force Hugging Face Hub offline mode once weights are cached (default: 0)
# HF_HUB_DOWNLOAD_TIMEOUT: maximum network wait time in seconds for HF Hub calls (default: 15.0)
# ------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024
EMBEDDING_OFFLINE_MODE=True
HF_HUB_OFFLINE=0
HF_HUB_DOWNLOAD_TIMEOUT=15.0

# ------------------------------------------------------------
# Retrieval Configuration
# RETRIEVAL_TOP_K: number of chunks returned per query (default: 5)
# RETRIEVAL_MIN_SIMILARITY: minimum cosine similarity required to answer
# ------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3

# ------------------------------------------------------------
# Hybrid Search Configuration
# ------------------------------------------------------------
ENABLE_HYBRID_SEARCH=True
SEMANTIC_TOP_K=10
BM25_TOP_K=10
RRF_K=60

# ------------------------------------------------------------
# Ollama Local LLM (Local Fallback Provider)
# ------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gemma3:4b
OLLAMA_TIMEOUT=180.0

# Disable ChromaDB anonymized telemetry error logs
ANONYMIZED_TELEMETRY=False

# ------------------------------------------------------------
# User Portal JWT Authentication
# USER_JWT_SECRET: Must be set to a secure random string in production.
#   Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# USER_JWT_EXPIRE_MINUTES: Token validity in minutes (default: 480 = 8 hours)
# USER_JWT_ALGORITHM: Signing algorithm (default: HS256)
# ------------------------------------------------------------
USER_JWT_SECRET=<generate-with-secrets.token_hex(32)>
USER_JWT_ALGORITHM=HS256
USER_JWT_EXPIRE_MINUTES=480

# ------------------------------------------------------------
# PostgreSQL — User Portal persistent authentication
# Required for self-registered User Portal accounts.
# When not set, the application falls back to the legacy
# registered_users.json file (development / no-DB mode).
#
# Format: postgresql://user:password@host:port/dbname
#
# After setting this value, run once:
#   python -m app.db.init_db
# ------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>
